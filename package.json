{
  "name": "universal-ai-resume-builder",
  "version": "1.0.0",
  "description": "AI Resume Builder MERN Stack",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run server --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "npm start",
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build": "./render-build.sh"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "nodemon": "^3.1.14"
  }
}
